# MRM local tooling configuration.
#
#   cp .env.example .env
#
# .env is gitignored (.gitignore:27) — put real values there, not here.
# Anything left blank below is resolved at runtime from SSM Parameter Store
# or CloudFormation stack outputs by scripts/mrm-env.sh.
#
# Precedence: exported environment variable > .env > SSM/CloudFormation.

# Region the MRM stacks are deployed in. Required if it differs from your
# default AWS CLI region, otherwise every lookup silently finds nothing.
AWS_REGION=us-east-1

# Derived from cdk.json `context.productName` when left blank.
#   "Media Resource Manager" -> MediaResourceManager / MRM
MRM_PASCAL_NAME=
MRM_ACRONYM=

# Web console. MRM-Frontend stack output `WebsiteUrl`.
MRM_FRONTEND_URL=https://d3hn5g7tcm5v68.cloudfront.net

# API Gateway base URL, no trailing slash.
# MRM-Api stack output `ApiUrl` / SSM /${MRM_PASCAL_NAME}/Workstation/ApiUrl.
MRM_API_URL=

# Optional. Pre-minted bearer token for scripts/mrm-api.sh.
# Blank => a short-lived token is minted from Secrets Manager
# (/${MRM_PASCAL_NAME}/Auth/JwtSecret) on demand.
MRM_AUTH_TOKEN=

# Optional. Identity baked into a minted token. Blank => derived from your AWS
# caller (aws sts get-caller-identity). scripts/mrm-api.sh mints an admin token
# by default; use its --as <user> flag to impersonate a specific non-admin user.
MRM_AUTH_USERNAME=
MRM_AUTH_EMAIL=

# Optional. Access token for whatever proxy fronts the web console.
# PLACEHOLDER ONLY — never commit a real value; keep it in .env.
MRM_CONSOLE_ACCESS_TOKEN=
